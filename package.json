{
  "name": "mix-id",
  "version": "1.0.6",
  "description": "Identify tracks in any DJ mix — from a file or URL. Outputs tracklists as TXT, CUE, and JSON.",
  "type": "module",
  "bin": {
    "mix-id": "./cli.mjs"
  },
  "files": [
    "cli.mjs",
    "lib/",
    "server.mjs",
    "ui/",
    "tools/essentia_bpmkey.py"
  ],
  "keywords": [
    "dj",
    "tracklist",
    "shazam",
    "music",
    "recognition",
    "mix",
    "cue",
    "mixcloud",
    "soundcloud",
    "audio",
    "fingerprint"
  ],
  "author": "Scott Bell",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mess023/Setscout"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "shazam-api": "^0.3.0"
  },
  "scripts": {
    "ui": "node server.mjs",
    "test": "node test/methods.test.mjs && node test/server.test.mjs"
  }
}
